# Must match GitHub Pages URL path if not at domain root (trailing slash). Example: /dixit/
VITE_BASE_PATH=/dixit/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Folder in the default bucket where card images live (no leading/trailing slash)
VITE_FIREBASE_CARDS_STORAGE_PREFIX=cards

